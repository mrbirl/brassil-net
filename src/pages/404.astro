---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="Page not found." noindex>
  <div class="nf-page">
    <div class="page-header">
      <h1>404</h1>
      <span class="page-meta">Page not found</span>
    </div>
    <p>Nothing here. It may have moved when the site was rebuilt.</p>
    <p><a href="/photos">Photographs</a> · <a href="/">Home</a></p>
  </div>
</BaseLayout>

<style>
  .nf-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px 40px 96px;
    font-size: 14px;
    line-height: 1.7;
  }

  .page-header {
    display: flex;
    align-items: baseline;
    gap: 24px;
    margin-bottom: 48px;
  }

  .page-header h1 {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }

  .page-meta {
    font-size: 11px;
    color: #737373;
    letter-spacing: 0.04em;
  }

  p { margin: 0 0 12px; }

  a {
    color: #0A0A0A;
    text-underline-offset: 3px;
  }

  @media (max-width: 767px) {
    .nf-page { padding: 40px 20px 64px; }
  }
</style>
