---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { PRINT_REQUEST_EMAIL } from '../../site';

export const getStaticPaths: GetStaticPaths = async () => {
  const photos = await getCollection('photos', ({ data }) => data.available);
  return photos.map((photo) => ({
    params: { slug: photo.data.slug },
    props: { photo },
  }));
};

const { photo } = Astro.props;
const { data } = photo;

const pageUrl = new URL(`/photos/${data.slug}/`, Astro.site).href;
const subject = 'Print request: ' + data.title;
const body = [
  'Hi Cian,',
  '',
  'I’d like to ask about a print of "' + data.title + '".',
  pageUrl,
  '',
  'Size I’m interested in:',
  'Shipping country:',
  '',
  'Thanks,',
].join('\n');
const mailto =
  'mailto:' + PRINT_REQUEST_EMAIL +
  '?subject=' + encodeURIComponent(subject) +
  '&body=' + encodeURIComponent(body);

const dateFormatted = data.dateTaken
  ? data.dateTaken.toLocaleDateString('en-IE', { month: 'long', year: 'numeric' })
  : null;
---

<BaseLayout title={data.title} description={data.description} image={data.image}>
  <div class="detail-page">

    <!-- Hero photo -->
    <div class="hero-wrap">
      {data.image ? (
        <Image
          src={data.image}
          alt={data.description}
          width={data.image.width}
          height={data.image.height}
          class="hero-img"
          loading="eager"
          transition:name={`photo-${data.slug}`}
        />
      ) : data.imageUrl ? (
        /* TODO: replace <img> with <Image> when local file replaces imageUrl */
        <img
          src={data.imageUrl}
          alt={data.description}
          width={data.imageWidth}
          height={data.imageHeight}
          class="hero-img"
          loading="eager"
          transition:name={`photo-${data.slug}`}
        />
      ) : null}

    </div>

    <!-- Title and metadata -->
    <div class="detail-meta">
      <h1 class="detail-title">{data.title}</h1>
      {(data.location || dateFormatted) && (
        <p class="detail-info">
          {[data.location, dateFormatted].filter(Boolean).join(' · ')}
        </p>
      )}
    </div>

    <p class="detail-description">{data.longDescription ?? data.description}</p>

    <div class="print-request">
      <p class="print-note">Prints available on request.</p>
      <a class="print-cta" href={mailto}>Request a print</a>
    </div>

    {/* TODO: related photos */}

  </div>
</BaseLayout>

<style>
  .detail-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px 96px;
  }

  .hero-wrap {
    position: relative;
    width: 100%;
    max-height: 75vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0A0A0A;
  }

  .hero-img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 75vh;
    object-fit: contain;
  }


  .detail-meta {
    padding-top: 32px;
  }

  .detail-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #FF5C1F;
    margin: 0 0 12px;
  }

  .detail-info {
    font-family: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    color: #737373;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .detail-description {
    max-width: 62ch;
    margin: 28px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: #0A0A0A;
  }

  .print-request {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid #E5E5E4;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .print-note {
    margin: 0;
    font-size: 12px;
    color: #737373;
  }

  .print-cta {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 100px;
    background: #0A0A0A;
    color: #F5F5F4;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .print-cta:hover {
    background: #333333;
  }

  .print-cta:focus-visible {
    outline: 2px solid #0A0A0A;
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .detail-page {
      padding: 0 20px 64px;
    }

    .hero-wrap {
      max-height: 60vh;
    }

    .hero-img {
      max-height: 60vh;
    }

    .detail-meta {
      padding-top: 24px;
    }
  }
</style>
